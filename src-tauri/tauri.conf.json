{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindmate",
  "version": "1.0.16",
  "identifier": "com.mindmate.desktop",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mindmate-10v.pages.dev/release/latest.json",
        "https://github.com/fosonRong/mindmate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBODA1Nzc5OTYzRDdGM0EKUldRNmZ6MldlVmVBR28wdmJGZnB4YnBqdkQ4NjNnTm04cXN2dVpMUTViakEvUEhyVVVRVEtCU3MK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "智伴 Mindmate — AI 工作生活伴侣",
    "longDescription": "随时记录工作生活、周期性提醒、待办日程管理、进度可视化，AI 一键生成日报/周报/月报。数据全部保存在本机。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
