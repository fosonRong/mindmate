# 依赖与构建产物
node_modules/

# 不提交 package-lock.json：本仓库同时构建 Windows 与 macOS，而在单一平台生成的 lock 会把
# 其它平台的可选原生依赖（rollup/esbuild 的 darwin-*/win32-* 二进制）剔除，
# 换平台构建就会报 "Cannot find module @rollup/rollup-darwin-arm64"（npm issue #4828）。
# CI 改为按当前平台解析依赖（见 .github/workflows/release.yml）。
package-lock.json
apps/web/dist/
src-tauri/target/
target/
core/target/
apps/web/node_modules/

# 运行时数据与本地环境
data/
*.db
*.db-wal
*.db-shm
*.db.bak.*
.first_seen
.env
.env.local
*.local

# 签名与密钥（**绝不入库**：更新签名私钥、代码签名证书、任何 token）
*.key
*.pem
*.pfx
*.p12
*.mobileprovision
secrets/
.tauri/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
logs/

# 一次性临时文件（设备码/推送日志等，绝不入库）
.tmp-*

# Python
__pycache__/
*.pyc

# 发布产物（由 CI 生成，不入库）
latest.json
canary.json
SHA256SUMS.txt
release/
artifacts/
